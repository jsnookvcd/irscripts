<#
.SYNOPSIS
    Mass Password Reset Utility - Tiered Password Reset for Incident Response
.DESCRIPTION
    This utility performs mass password resets across Active Directory in a tiered approach:

    Tier 1: Domain Admins and Enterprise Admins (highest priority)
    Tier 2: Service Accounts (identified by naming convention or OU)
    Tier 3: Standard Users (all remaining enabled users)

    Features:
    - Generates secure random passwords or uses a specified password policy
    - Exports detailed reports with new credentials (secured)
    - Supports WhatIf mode for dry-run testing
    - Configurable exclusion lists
    - Option to force password change at next logon
    - Email notification capability for users

    SECURITY WARNING: This script generates sensitive credential data.
    Ensure reports are stored securely and transmitted via encrypted channels.

.AUTHOR
    IR Security Team
.PARAMETER Tier
    Which tier(s) to reset: DomainAdmins, ServiceAccounts, StandardUsers, or All
.PARAMETER PasswordLength
    Length of generated passwords. Default: 16
.PARAMETER RequireChangeAtLogon
    Force users to change password at next logon. Default: $true for StandardUsers
.PARAMETER ExcludeUsers
    Array of SamAccountNames to exclude from reset
.PARAMETER ExcludeOUs
    Array of OU distinguished names to exclude
.PARAMETER ServiceAccountOUs
    Array of OUs containing service accounts
.PARAMETER ServiceAccountPrefix
    Naming prefixes that identify service accounts (e.g., "svc_", "sa_")
.PARAMETER OutputPath
    Directory for credential reports. Default: C:\PasswordReset_Reports
.PARAMETER EncryptReport
    Encrypt the credential report with a certificate
.PARAMETER NotifyUsers
    Send email notifications to users (requires SMTP configuration)
.PARAMETER SMTPServer
    SMTP server for email notifications
.PARAMETER FromAddress
    From address for email notifications
.PARAMETER CustomPassword
    Use a specific password instead of random generation (not recommended)
.EXAMPLE
    .\mass-password-reset -Tier DomainAdmins -WhatIf
    Dry run showing which Domain Admin accounts would be reset.
.EXAMPLE
    .\mass-password-reset -Tier All -OutputPath C:\SecureReports
    Resets all tiers and exports reports to specified path.
.EXAMPLE
    .\mass-password-reset -Tier ServiceAccounts -ServiceAccountPrefix @("svc_","sa_","service.")
    Resets accounts matching service account naming conventions.
.EXAMPLE
    .\mass-password-reset -Tier StandardUsers -RequireChangeAtLogon -NotifyUsers -SMTPServer mail.domain.com
    Resets standard users, forces password change, and sends email notifications.
#>

[CmdletBinding(SupportsShouldProcess = $true, ConfirmImpact = 'High')]
param(
    [Parameter(Mandatory = $true)]
    [ValidateSet("DomainAdmins", "ServiceAccounts", "StandardUsers", "All")]
    [string[]]$Tier,

    [Parameter(Mandatory = $false)]
    [ValidateRange(12, 128)]
    [int]$PasswordLength = 16,

    [Parameter(Mandatory = $false)]
    [switch]$RequireChangeAtLogon,

    [Parameter(Mandatory = $false)]
    [string[]]$ExcludeUsers = @(),

    [Parameter(Mandatory = $false)]
    [string[]]$ExcludeOUs = @(),

    [Parameter(Mandatory = $false)]
    [string[]]$ServiceAccountOUs = @(),

    [Parameter(Mandatory = $false)]
    [string[]]$ServiceAccountPrefix = @("svc_", "svc-", "sa_", "sa-", "service_", "service-", "srv_", "srv-"),

    [Parameter(Mandatory = $false)]
    [string]$OutputPath = "C:\PasswordReset_Reports",

    [Parameter(Mandatory = $false)]
    [switch]$EncryptReport,

    [Parameter(Mandatory = $false)]
    [string]$EncryptionCertThumbprint,

    [Parameter(Mandatory = $false)]
    [switch]$NotifyUsers,

    [Parameter(Mandatory = $false)]
    [string]$SMTPServer,

    [Parameter(Mandatory = $false)]
    [string]$FromAddress,

    [Parameter(Mandatory = $false)]
    [string]$EmailSubject = "Password Reset Notification - Action Required",

    [Parameter(Mandatory = $false)]
    [string]$CustomPassword
)

# ============================================================================
# CONFIGURATION
# ============================================================================

$Timestamp = Get-Date -Format "yyyyMMdd_HHmmss"
$ReportPrefix = "PasswordReset"

# Privileged groups to identify Domain Admins tier
$PrivilegedGroups = @(
    "Domain Admins",
    "Enterprise Admins",
    "Schema Admins",
    "Administrators",
    "Account Operators",
    "Backup Operators",
    "Server Operators",
    "Print Operators"
)

# Built-in accounts to always exclude
$BuiltInExclusions = @(
    "Administrator",
    "Guest",
    "krbtgt",
    "DefaultAccount",
    "WDAGUtilityAccount"
)

# Password character sets
$PasswordCharSets = @{
    Uppercase = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'
    Lowercase = 'abcdefghijklmnopqrstuvwxyz'
    Numbers   = '0123456789'
    Symbols   = '!@#$%^&*()_+-=[]{}|;:,.<>?'
}

# ============================================================================
# HELPER FUNCTIONS
# ============================================================================

function Write-ResetLog {
    param(
        [string]$Message,
        [ValidateSet("Info", "Success", "Warning", "Error", "Critical")]
        [string]$Level = "Info"
    )

    $Prefix = switch ($Level) {
        "Info"     { "[*]"; $Color = "Cyan" }
        "Success"  { "[+]"; $Color = "Green" }
        "Warning"  { "[!]"; $Color = "Yellow" }
        "Error"    { "[-]"; $Color = "Red" }
        "Critical" { "[!!!]"; $Color = "Magenta" }
    }

    $LogMessage = "$(Get-Date -Format 'yyyy-MM-dd HH:mm:ss') $Prefix $Message"
    Write-Host $LogMessage -ForegroundColor $Color

    if ($script:LogFile) {
        Add-Content -Path $script:LogFile -Value $LogMessage -ErrorAction SilentlyContinue
    }
}

function Initialize-Environment {
    Write-ResetLog "Initializing Mass Password Reset Utility..." -Level Info

    # Create output directory
    if (-not (Test-Path $OutputPath)) {
        New-Item -ItemType Directory -Path $OutputPath -Force | Out-Null
        Write-ResetLog "Created output directory: $OutputPath" -Level Success
    }

    # Secure the output directory (remove inheritance, restrict access)
    try {
        $Acl = Get-Acl $OutputPath
        $Acl.SetAccessRuleProtection($true, $false)
        $AdminRule = New-Object System.Security.AccessControl.FileSystemAccessRule(
            "BUILTIN\Administrators", "FullControl", "ContainerInherit,ObjectInherit", "None", "Allow"
        )
        $Acl.AddAccessRule($AdminRule)
        Set-Acl -Path $OutputPath -AclObject $Acl -ErrorAction SilentlyContinue
        Write-ResetLog "Secured output directory permissions" -Level Success
    }
    catch {
        Write-ResetLog "Could not restrict directory permissions: $_" -Level Warning
    }

    # Initialize log file
    $script:LogFile = Join-Path $OutputPath "$ReportPrefix`_$Timestamp.log"
    Write-ResetLog "Log file: $script:LogFile" -Level Info

    # Verify AD module
    try {
        Import-Module ActiveDirectory -ErrorAction Stop
        Write-ResetLog "Active Directory module loaded" -Level Success
    }
    catch {
        Write-ResetLog "Failed to load Active Directory module: $_" -Level Error
        throw "Active Directory module is required"
    }

    # Get domain info
    try {
        $script:Domain = Get-ADDomain
        $script:DomainDN = $script:Domain.DistinguishedName
        $script:DomainName = $script:Domain.DNSRoot
        Write-ResetLog "Connected to domain: $($script:DomainName)" -Level Success
    }
    catch {
        Write-ResetLog "Failed to query domain: $_" -Level Error
        throw "Cannot connect to Active Directory"
    }

    # Validate email settings if notifications enabled
    if ($NotifyUsers) {
        if (-not $SMTPServer -or -not $FromAddress) {
            Write-ResetLog "NotifyUsers requires SMTPServer and FromAddress parameters" -Level Error
            throw "Email notification parameters missing"
        }
    }
}

function New-SecurePassword {
    param(
        [int]$Length = 16
    )

    # Ensure password meets complexity requirements
    $Password = @()

    # Add at least one character from each set
    $Password += Get-Random -InputObject $PasswordCharSets.Uppercase.ToCharArray() -Count 1
    $Password += Get-Random -InputObject $PasswordCharSets.Lowercase.ToCharArray() -Count 1
    $Password += Get-Random -InputObject $PasswordCharSets.Numbers.ToCharArray() -Count 1
    $Password += Get-Random -InputObject $PasswordCharSets.Symbols.ToCharArray() -Count 1

    # Fill remaining length with random characters from all sets
    $AllChars = ($PasswordCharSets.Values -join '')
    $RemainingLength = $Length - 4
    $Password += Get-Random -InputObject $AllChars.ToCharArray() -Count $RemainingLength

    # Shuffle the password
    $ShuffledPassword = ($Password | Sort-Object { Get-Random }) -join ''

    return $ShuffledPassword
}

function ConvertTo-SecureStringPassword {
    param([string]$PlainTextPassword)

    return ConvertTo-SecureString -String $PlainTextPassword -AsPlainText -Force
}

function Test-IsExcluded {
    param(
        [Microsoft.ActiveDirectory.Management.ADUser]$User
    )

    # Check built-in exclusions
    if ($User.SamAccountName -in $BuiltInExclusions) {
        return $true
    }

    # Check user exclusion list
    if ($User.SamAccountName -in $ExcludeUsers) {
        return $true
    }

    # Check OU exclusions
    foreach ($ExcludeOU in $ExcludeOUs) {
        if ($User.DistinguishedName -like "*$ExcludeOU*") {
            return $true
        }
    }

    return $false
}

function Get-UserTier {
    param(
        [Microsoft.ActiveDirectory.Management.ADUser]$User
    )

    # Check if user is in privileged groups (Domain Admin tier)
    foreach ($Group in $PrivilegedGroups) {
        try {
            $GroupMembers = Get-ADGroupMember -Identity $Group -Recursive -ErrorAction SilentlyContinue |
                Select-Object -ExpandProperty SamAccountName

            if ($User.SamAccountName -in $GroupMembers) {
                return "DomainAdmins"
            }
        }
        catch {
            # Group may not exist in all domains
        }
    }

    # Check if user is a service account
    foreach ($Prefix in $ServiceAccountPrefix) {
        if ($User.SamAccountName -like "$Prefix*") {
            return "ServiceAccounts"
        }
    }

    # Check if user is in service account OUs
    foreach ($ServiceOU in $ServiceAccountOUs) {
        if ($User.DistinguishedName -like "*$ServiceOU*") {
            return "ServiceAccounts"
        }
    }

    # Default to standard user
    return "StandardUsers"
}

# ============================================================================
# USER COLLECTION FUNCTIONS
# ============================================================================

function Get-DomainAdminUsers {
    Write-ResetLog "Collecting Domain Admin tier accounts..." -Level Info

    $AdminUsers = @()

    foreach ($Group in $PrivilegedGroups) {
        try {
            $Members = Get-ADGroupMember -Identity $Group -Recursive -ErrorAction SilentlyContinue |
                Where-Object { $_.objectClass -eq 'user' }

            foreach ($Member in $Members) {
                $User = Get-ADUser -Identity $Member.SamAccountName -Properties * -ErrorAction SilentlyContinue
                if ($User -and $User.Enabled -and -not (Test-IsExcluded -User $User)) {
                    $AdminUsers += $User
                }
            }
        }
        catch {
            Write-ResetLog "Could not enumerate group $Group" -Level Warning
        }
    }

    # Remove duplicates
    $AdminUsers = $AdminUsers | Sort-Object SamAccountName -Unique

    Write-ResetLog "Found $($AdminUsers.Count) Domain Admin tier accounts" -Level Info
    return $AdminUsers
}

function Get-ServiceAccountUsers {
    Write-ResetLog "Collecting Service Account tier accounts..." -Level Info

    $ServiceUsers = @()

    # Get users by naming convention
    foreach ($Prefix in $ServiceAccountPrefix) {
        try {
            $Users = Get-ADUser -Filter "SamAccountName -like '$Prefix*'" -Properties * -ErrorAction SilentlyContinue |
                Where-Object { $_.Enabled -and -not (Test-IsExcluded -User $_) }

            $ServiceUsers += $Users
        }
        catch {
            Write-ResetLog "Error searching for prefix $Prefix" -Level Warning
        }
    }

    # Get users from service account OUs
    foreach ($ServiceOU in $ServiceAccountOUs) {
        try {
            $Users = Get-ADUser -Filter { Enabled -eq $true } -SearchBase $ServiceOU -Properties * -ErrorAction SilentlyContinue |
                Where-Object { -not (Test-IsExcluded -User $_) }

            $ServiceUsers += $Users
        }
        catch {
            Write-ResetLog "Error searching OU $ServiceOU" -Level Warning
        }
    }

    # Remove duplicates and exclude Domain Admins
    $AdminSAMs = (Get-DomainAdminUsers | Select-Object -ExpandProperty SamAccountName)
    $ServiceUsers = $ServiceUsers |
        Sort-Object SamAccountName -Unique |
        Where-Object { $_.SamAccountName -notin $AdminSAMs }

    Write-ResetLog "Found $($ServiceUsers.Count) Service Account tier accounts" -Level Info
    return $ServiceUsers
}

function Get-StandardUsers {
    Write-ResetLog "Collecting Standard User tier accounts..." -Level Info

    # Get all enabled users
    $AllUsers = Get-ADUser -Filter { Enabled -eq $true } -Properties * -ErrorAction SilentlyContinue

    # Get users from other tiers to exclude
    $AdminSAMs = (Get-DomainAdminUsers | Select-Object -ExpandProperty SamAccountName)
    $ServiceSAMs = (Get-ServiceAccountUsers | Select-Object -ExpandProperty SamAccountName)

    $StandardUsers = $AllUsers | Where-Object {
        -not (Test-IsExcluded -User $_) -and
        $_.SamAccountName -notin $AdminSAMs -and
        $_.SamAccountName -notin $ServiceSAMs
    }

    Write-ResetLog "Found $($StandardUsers.Count) Standard User tier accounts" -Level Info
    return $StandardUsers
}

# ============================================================================
# PASSWORD RESET FUNCTIONS
# ============================================================================

function Reset-UserPassword {
    param(
        [Microsoft.ActiveDirectory.Management.ADUser]$User,
        [string]$TierName,
        [bool]$ForceChangeAtLogon
    )

    $Result = [PSCustomObject]@{
        Timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
        Tier = $TierName
        SamAccountName = $User.SamAccountName
        DisplayName = $User.DisplayName
        Email = $User.EmailAddress
        DistinguishedName = $User.DistinguishedName
        NewPassword = $null
        Status = "Pending"
        RequireChange = $ForceChangeAtLogon
        ErrorMessage = $null
    }

    try {
        # Generate or use custom password
        if ($CustomPassword) {
            $NewPassword = $CustomPassword
            Write-ResetLog "  Using custom password for $($User.SamAccountName)" -Level Warning
        }
        else {
            $NewPassword = New-SecurePassword -Length $PasswordLength
        }

        $Result.NewPassword = $NewPassword
        $SecurePassword = ConvertTo-SecureStringPassword -PlainTextPassword $NewPassword

        # Perform password reset with WhatIf support
        if ($PSCmdlet.ShouldProcess($User.SamAccountName, "Reset password")) {
            Set-ADAccountPassword -Identity $User.SamAccountName -NewPassword $SecurePassword -Reset -ErrorAction Stop

            # Set password change requirement if specified
            if ($ForceChangeAtLogon) {
                Set-ADUser -Identity $User.SamAccountName -ChangePasswordAtLogon $true -ErrorAction Stop
            }

            $Result.Status = "Success"
            Write-ResetLog "  Reset password for $($User.SamAccountName)" -Level Success
        }
        else {
            $Result.Status = "WhatIf"
            Write-ResetLog "  [WhatIf] Would reset password for $($User.SamAccountName)" -Level Info
        }
    }
    catch {
        $Result.Status = "Failed"
        $Result.ErrorMessage = $_.Exception.Message
        Write-ResetLog "  Failed to reset password for $($User.SamAccountName): $($_.Exception.Message)" -Level Error
    }

    return $Result
}

function Invoke-TierReset {
    param(
        [string]$TierName,
        [array]$Users,
        [bool]$ForceChangeAtLogon
    )

    Write-ResetLog "========================================" -Level Info
    Write-ResetLog "Processing Tier: $TierName" -Level Info
    Write-ResetLog "Users to process: $($Users.Count)" -Level Info
    Write-ResetLog "========================================" -Level Info

    $Results = @()

    $Counter = 0
    foreach ($User in $Users) {
        $Counter++
        Write-Progress -Activity "Resetting $TierName passwords" -Status "$Counter of $($Users.Count)" -PercentComplete (($Counter / $Users.Count) * 100)

        $Result = Reset-UserPassword -User $User -TierName $TierName -ForceChangeAtLogon $ForceChangeAtLogon
        $Results += $Result

        # Send notification if enabled and reset was successful
        if ($NotifyUsers -and $Result.Status -eq "Success" -and $User.EmailAddress) {
            Send-PasswordNotification -User $User -NewPassword $Result.NewPassword -ForceChange $ForceChangeAtLogon
        }
    }

    Write-Progress -Activity "Resetting $TierName passwords" -Completed

    # Summary for tier
    $SuccessCount = ($Results | Where-Object { $_.Status -eq "Success" }).Count
    $FailedCount = ($Results | Where-Object { $_.Status -eq "Failed" }).Count
    $WhatIfCount = ($Results | Where-Object { $_.Status -eq "WhatIf" }).Count

    Write-ResetLog "Tier $TierName Complete - Success: $SuccessCount, Failed: $FailedCount, WhatIf: $WhatIfCount" -Level $(if ($FailedCount -gt 0) { "Warning" } else { "Success" })

    return $Results
}

# ============================================================================
# NOTIFICATION FUNCTIONS
# ============================================================================

function Send-PasswordNotification {
    param(
        [Microsoft.ActiveDirectory.Management.ADUser]$User,
        [string]$NewPassword,
        [bool]$ForceChange
    )

    if (-not $User.EmailAddress) {
        Write-ResetLog "  No email address for $($User.SamAccountName), skipping notification" -Level Warning
        return
    }

    $Body = @"
Dear $($User.DisplayName),

Your password has been reset as part of a security operation.

Username: $($User.SamAccountName)
New Password: $NewPassword

$(if ($ForceChange) { "IMPORTANT: You will be required to change your password at your next login." })

If you did not expect this password reset, please contact the IT Security team immediately.

This is an automated message from the IT Security Team.
Do not reply to this email.
"@

    try {
        $EmailParams = @{
            From = $FromAddress
            To = $User.EmailAddress
            Subject = $EmailSubject
            Body = $Body
            SmtpServer = $SMTPServer
            Priority = "High"
        }

        if ($PSCmdlet.ShouldProcess($User.EmailAddress, "Send password notification email")) {
            Send-MailMessage @EmailParams -ErrorAction Stop
            Write-ResetLog "  Notification sent to $($User.EmailAddress)" -Level Success
        }
    }
    catch {
        Write-ResetLog "  Failed to send notification to $($User.EmailAddress): $_" -Level Warning
    }
}

# ============================================================================
# REPORT FUNCTIONS
# ============================================================================

function Export-CredentialReport {
    param(
        [array]$Results,
        [string]$TierName
    )

    $ReportFile = Join-Path $OutputPath "$ReportPrefix`_$TierName`_$Timestamp.csv"

    # Export full credential report (sensitive!)
    $Results | Export-Csv -Path $ReportFile -NoTypeInformation -Encoding UTF8

    # Encrypt if requested
    if ($EncryptReport -and $EncryptionCertThumbprint) {
        try {
            $Cert = Get-ChildItem -Path Cert:\LocalMachine\My\$EncryptionCertThumbprint -ErrorAction Stop
            $EncryptedFile = "$ReportFile.encrypted"

            $Content = Get-Content -Path $ReportFile -Raw
            $Bytes = [System.Text.Encoding]::UTF8.GetBytes($Content)
            $EncryptedBytes = $Cert.PublicKey.Key.Encrypt($Bytes, $true)
            [System.IO.File]::WriteAllBytes($EncryptedFile, $EncryptedBytes)

            Remove-Item -Path $ReportFile -Force
            Write-ResetLog "Encrypted credential report saved: $EncryptedFile" -Level Success
        }
        catch {
            Write-ResetLog "Failed to encrypt report: $_" -Level Warning
        }
    }
    else {
        Write-ResetLog "Credential report saved: $ReportFile" -Level Success
        Write-ResetLog "WARNING: Report contains plaintext passwords - secure immediately!" -Level Critical
    }

    return $ReportFile
}

function Export-SummaryReport {
    param([hashtable]$AllResults)

    $SummaryFile = Join-Path $OutputPath "$ReportPrefix`_Summary_$Timestamp.csv"

    $Summary = @()

    foreach ($TierName in $AllResults.Keys) {
        $TierResults = $AllResults[$TierName]

        $Summary += [PSCustomObject]@{
            Tier = $TierName
            TotalAccounts = $TierResults.Count
            Successful = ($TierResults | Where-Object { $_.Status -eq "Success" }).Count
            Failed = ($TierResults | Where-Object { $_.Status -eq "Failed" }).Count
            WhatIf = ($TierResults | Where-Object { $_.Status -eq "WhatIf" }).Count
            RequireChangeAtLogon = ($TierResults | Where-Object { $_.RequireChange -eq $true }).Count
            NotificationsAttempted = ($TierResults | Where-Object { $_.Email }).Count
        }
    }

    $Summary | Export-Csv -Path $SummaryFile -NoTypeInformation -Encoding UTF8
    Write-ResetLog "Summary report saved: $SummaryFile" -Level Success

    # Display summary
    Write-Host ""
    Write-Host "============================================================" -ForegroundColor Cyan
    Write-Host "  PASSWORD RESET SUMMARY" -ForegroundColor Cyan
    Write-Host "============================================================" -ForegroundColor Cyan

    foreach ($Row in $Summary) {
        Write-Host ""
        Write-Host "  $($Row.Tier):" -ForegroundColor Yellow
        Write-Host "    Total Accounts:    $($Row.TotalAccounts)"
        Write-Host "    Successful:        $($Row.Successful)" -ForegroundColor Green
        Write-Host "    Failed:            $($Row.Failed)" -ForegroundColor $(if ($Row.Failed -gt 0) { "Red" } else { "Green" })
        Write-Host "    Change Required:   $($Row.RequireChangeAtLogon)"
    }

    Write-Host ""
    return $SummaryFile
}

function Export-FailureReport {
    param([hashtable]$AllResults)

    $Failures = @()

    foreach ($TierName in $AllResults.Keys) {
        $TierFailures = $AllResults[$TierName] | Where-Object { $_.Status -eq "Failed" }
        $Failures += $TierFailures
    }

    if ($Failures.Count -gt 0) {
        $FailureFile = Join-Path $OutputPath "$ReportPrefix`_Failures_$Timestamp.csv"
        $Failures | Select-Object Timestamp, Tier, SamAccountName, DisplayName, DistinguishedName, ErrorMessage |
            Export-Csv -Path $FailureFile -NoTypeInformation -Encoding UTF8
        Write-ResetLog "Failure report saved: $FailureFile" -Level Warning
        return $FailureFile
    }

    return $null
}

# ============================================================================
# MAIN EXECUTION
# ============================================================================

Write-Host ""
Write-Host "============================================================" -ForegroundColor Cyan
Write-Host "  MASS PASSWORD RESET UTILITY - Incident Response" -ForegroundColor Cyan
Write-Host "============================================================" -ForegroundColor Cyan
Write-Host ""

# Safety confirmation
if (-not $WhatIfPreference) {
    Write-Host "WARNING: This utility will reset passwords for multiple accounts!" -ForegroundColor Red
    Write-Host "Tiers selected: $($Tier -join ', ')" -ForegroundColor Yellow
    Write-Host ""

    if (-not $PSCmdlet.ShouldProcess("Multiple AD accounts", "Mass password reset")) {
        Write-Host "Operation cancelled." -ForegroundColor Yellow
        exit 0
    }
}

# Initialize
Initialize-Environment

# Determine which tiers to process
$TiersToProcess = @()
if ("All" -in $Tier) {
    $TiersToProcess = @("DomainAdmins", "ServiceAccounts", "StandardUsers")
}
else {
    $TiersToProcess = $Tier
}

Write-ResetLog "Processing tiers: $($TiersToProcess -join ', ')" -Level Info
Write-ResetLog "Password length: $PasswordLength characters" -Level Info
Write-ResetLog "Excluded users: $($ExcludeUsers.Count + $BuiltInExclusions.Count)" -Level Info

# Collect and process each tier
$AllResults = @{}
$ReportFiles = @()

foreach ($TierName in $TiersToProcess) {
    # Get users for this tier
    $Users = switch ($TierName) {
        "DomainAdmins"    { Get-DomainAdminUsers }
        "ServiceAccounts" { Get-ServiceAccountUsers }
        "StandardUsers"   { Get-StandardUsers }
    }

    if ($Users.Count -eq 0) {
        Write-ResetLog "No users found for tier: $TierName" -Level Warning
        continue
    }

    # Determine if change at logon is required
    $ForceChange = switch ($TierName) {
        "DomainAdmins"    { $RequireChangeAtLogon.IsPresent }
        "ServiceAccounts" { $false }  # Service accounts typically shouldn't require change
        "StandardUsers"   { $true }   # Standard users should always change
    }

    # Override with explicit parameter
    if ($RequireChangeAtLogon.IsPresent) {
        $ForceChange = $true
    }

    # Process the tier
    $TierResults = Invoke-TierReset -TierName $TierName -Users $Users -ForceChangeAtLogon $ForceChange
    $AllResults[$TierName] = $TierResults

    # Export tier credential report
    $ReportFile = Export-CredentialReport -Results $TierResults -TierName $TierName
    $ReportFiles += $ReportFile
}

# Export summary and failure reports
Export-SummaryReport -AllResults $AllResults
$FailureReport = Export-FailureReport -AllResults $AllResults

# Final summary
Write-Host ""
Write-ResetLog "========================================" -Level Info
Write-ResetLog "Mass Password Reset Complete" -Level Success
Write-ResetLog "========================================" -Level Info
Write-ResetLog "Reports saved to: $OutputPath" -Level Info
Write-ResetLog "Log file: $($script:LogFile)" -Level Info

if ($ReportFiles.Count -gt 0) {
    Write-Host ""
    Write-ResetLog "SECURITY REMINDER:" -Level Critical
    Write-ResetLog "  1. Credential reports contain PLAINTEXT PASSWORDS" -Level Critical
    Write-ResetLog "  2. Secure or encrypt reports immediately" -Level Critical
    Write-ResetLog "  3. Use secure channels to distribute credentials" -Level Critical
    Write-ResetLog "  4. Delete reports after credentials are distributed" -Level Critical
}

Write-Host ""
