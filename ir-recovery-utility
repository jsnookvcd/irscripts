function Invoke-ExfilSearch {
    param([array]$Patterns)

    Write-IRLog "========================================" -Level Info
    Write-IRLog "Starting Exfiltration Data Search" -Level Info
    Write-IRLog "========================================" -Level Info

    $ExfilResults = @()

    # Get target computers
    $Computers = Get-TargetComputers
    Write-IRLog "Scanning $($Computers.Count) computer(s) for potential exfiltrated data" -Level Info
    Write-IRLog "Search patterns: $($Patterns.Count)" -Level Info

    foreach ($Computer in $Computers) {
        Write-IRLog "Scanning: $Computer" -Level Info

        if (-not (Test-ComputerConnectivity -ComputerName $Computer)) {
            if ($IncludeOffline) {
                $ExfilResults += [PSCustomObject]@{
                    ComputerName = $Computer
                    MatchType = "N/A"
                    Pattern = "N/A"
                    FilePath = "OFFLINE"
                    FileSize = 0
                    Created = $null
                    Modified = $null
                    Details = "Computer unreachable"
                }
            }
            Write-IRLog "  Computer offline, skipping..." -Level Warning
            continue
        }

        # Search staging directories for pattern matches
        $ExfilResults += Search-ExfilPatterns -Computer $Computer -Patterns $Patterns

        # Search for large archive files in staging locations
        $ExfilResults += Search-ExfilArchives -Computer $Computer

        # Check for recently modified sensitive files
        $ExfilResults += Search-RecentSensitiveFiles -Computer $Computer -Patterns $Patterns
    }

    # Export exfiltration search results
    Export-ExfilReport -ExfilResults $ExfilResults

    return $ExfilResults
}

function Search-ExfilPatterns {
    param(
        [string]$Computer,
        [array]$Patterns
    )

    $Results = @()
    Write-IRLog "  Searching for exfiltration patterns in files..." -Level Info

    $SearchPaths = @(
        "\\$Computer\C$\Windows\Temp",
        "\\$Computer\C$\Temp",
        "\\$Computer\C$\PerfLogs",
        "\\$Computer\C$\Users\Public",
        "\\$Computer\C$\ProgramData"
    )

    foreach ($SearchPath in $SearchPaths) {
        try {
            if (-not (Test-Path $SearchPath -ErrorAction SilentlyContinue)) { continue }

            $Files = Get-ChildItem -Path $SearchPath -Recurse -File -Force -Depth $ScanDepth -ErrorAction SilentlyContinue |
                Where-Object { $_.Length -lt 50MB -and $_.Extension -in @('.txt', '.csv', '.log', '.xml', '.json', '.sql', '.xlsx', '.docx') }

            foreach ($File in $Files) {
                foreach ($Pattern in $Patterns) {
                    try {
                        $Content = Get-Content -Path $File.FullName -TotalCount 1000 -ErrorAction SilentlyContinue
                        if ($Content -match $Pattern) {
                            $Results += [PSCustomObject]@{
                                ComputerName = $Computer
                                MatchType = "ContentPattern"
                                Pattern = $Pattern
                                FilePath = $File.FullName
                                FileSize = $File.Length
                                Created = $File.CreationTime
                                Modified = $File.LastWriteTime
                                Details = "Pattern found in file content"
                            }
                            Write-IRLog "    FOUND PATTERN: $Pattern in $($File.FullName)" -Level Warning
                            break  # Only report once per file
                        }
                    }
                    catch { }
                }
            }
        }
        catch {
            # Silent continue
        }
    }

    return $Results
}

function Search-ExfilArchives {
    param([string]$Computer)

    $Results = @()
    Write-IRLog "  Searching for suspicious archive files..." -Level Info

    foreach ($StagingDir in $ExfilStagingDirs) {
        $RemotePath = $StagingDir -replace '^C:', "\\$Computer\C$"

        try {
            if (-not (Test-Path $RemotePath -ErrorAction SilentlyContinue)) { continue }

            # Find large archive files (potential staged exfil data)
            $Archives = Get-ChildItem -Path $RemotePath -Recurse -File -Force -Depth 3 -ErrorAction SilentlyContinue |
                Where-Object {
                    $_.Extension -in $ExfilExtensions -and
                    $_.Length -gt 10MB  # Suspicious if large archive in staging location
                }

            foreach ($Archive in $Archives) {
                $Results += [PSCustomObject]@{
                    ComputerName = $Computer
                    MatchType = "SuspiciousArchive"
                    Pattern = $Archive.Extension
                    FilePath = $Archive.FullName
                    FileSize = $Archive.Length
                    Created = $Archive.CreationTime
                    Modified = $Archive.LastWriteTime
                    Details = "Large archive in staging directory ($('{0:N2}' -f ($Archive.Length / 1MB)) MB)"
                }
                Write-IRLog "    SUSPICIOUS ARCHIVE: $($Archive.FullName) ($('{0:N2}' -f ($Archive.Length / 1MB)) MB)" -Level Warning
            }
        }
        catch {
            # Silent continue
        }
    }

    return $Results
}

function Search-RecentSensitiveFiles {
    param(
        [string]$Computer,
        [array]$Patterns
    )

    $Results = @()
    Write-IRLog "  Searching for recently modified sensitive files..." -Level Info

    $CutoffTime = (Get-Date).AddDays(-7)  # Files modified in last 7 days

    $SensitivePaths = @(
        "\\$Computer\C$\Users",
        "\\$Computer\C$\ProgramData"
    )

    $SensitiveExtensions = @('.pst', '.ost', '.kdbx', '.key', '.pem', '.pfx', '.sql', '.bak', '.mdb')

    foreach ($SearchPath in $SensitivePaths) {
        try {
            if (-not (Test-Path $SearchPath -ErrorAction SilentlyContinue)) { continue }

            $SensitiveFiles = Get-ChildItem -Path $SearchPath -Recurse -File -Force -Depth $ScanDepth -ErrorAction SilentlyContinue |
                Where-Object {
                    $_.Extension -in $SensitiveExtensions -and
                    $_.LastWriteTime -gt $CutoffTime
                }

            foreach ($File in $SensitiveFiles) {
                $Results += [PSCustomObject]@{
                    ComputerName = $Computer
                    MatchType = "RecentSensitiveFile"
                    Pattern = $File.Extension
                    FilePath = $File.FullName
                    FileSize = $File.Length
                    Created = $File.CreationTime
                    Modified = $File.LastWriteTime
                    Details = "Recently modified sensitive file type"
                }
                Write-IRLog "    RECENT SENSITIVE FILE: $($File.FullName)" -Level Warning
            }
        }
        catch {
            # Silent continue
        }
    }

    # Also search for files matching patterns by name
    foreach ($Pattern in $Patterns) {
        foreach ($SearchPath in $SensitivePaths) {
            try {
                if (-not (Test-Path $SearchPath -ErrorAction SilentlyContinue)) { continue }

                $MatchingFiles = Get-ChildItem -Path $SearchPath -Recurse -File -Force -Depth $ScanDepth -ErrorAction SilentlyContinue |
                    Where-Object { $_.Name -match $Pattern }

                foreach ($File in $MatchingFiles) {
                    $Results += [PSCustomObject]@{
                        ComputerName = $Computer
                        MatchType = "FilenamePattern"
                        Pattern = $Pattern
                        FilePath = $File.FullName
                        FileSize = $File.Length
                        Created = $File.CreationTime
                        Modified = $File.LastWriteTime
                        Details = "Filename matches search pattern"
                    }
                    Write-IRLog "    FILENAME MATCH: $($File.FullName) (pattern: $Pattern)" -Level Warning
                }
            }
            catch {
                # Silent continue
            }
        }
    }

    return $Results
}

function Export-ExfilReport {
    param($ExfilResults)

    $ReportFile = Join-Path $OutputPath "$ReportPrefix`_ExfilSearch_$Timestamp.csv"

    if ($ExfilResults.Count -gt 0) {
        $ExfilResults | Export-Csv -Path $ReportFile -NoTypeInformation -Encoding UTF8
        Write-IRLog "Exfiltration Search report saved: $ReportFile" -Level Success
        Write-IRLog "Total potential exfiltration indicators found: $($ExfilResults.Count)" -Level Warning

        # Summary by type
        $Summary = $ExfilResults | Group-Object MatchType | Select-Object Name, Count
        foreach ($Type in $Summary) {
            Write-IRLog "  - $($Type.Name): $($Type.Count) findings" -Level Info
        }
    }
    else {
        Write-IRLog "No exfiltration indicators found" -Level Success
        "No exfiltration indicators found during scan at $Timestamp" | Out-File $ReportFile
    }
}

